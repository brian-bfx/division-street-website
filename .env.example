# ─── Email (Resend) — required for form submissions ───
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Where sign-up and contact form leads are delivered
LEAD_NOTIFICATION_EMAIL=hello@divisionstreetdigital.com

# Verified sender in Resend (must match a domain you've verified)
RESEND_FROM_EMAIL=Division Street Digital <hello@divisionstreetdigital.com>

# ─── Google Analytics 4 ───
# Find in GA4 → Admin → Data Streams → your stream → Measurement ID
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# ─── Google Ads ───
# Find in Google Ads → Tools → Conversions → tag setup → AW- ID
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Conversion labels — create conversion actions in Google Ads first, then paste full send_to values:
# Format: AW-XXXXXXXXXX/AbCdEfGhIjKlMnOpQr
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION=AW-XXXXXXXXXX/xxxxxxxx
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_CONVERSION=AW-XXXXXXXXXX/xxxxxxxx

#!/bin/sh
# Block commits that include local env files or other secret-bearing paths.

blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^\.env(\.|$)|^\.env\.local$|^\.env\..+\.local$|\.pem$|^\.pexels-cache\.json$' | grep -v '^\.env\.example$' || true)

if [ -n "$blocked" ]; then
  echo "ERROR: Refusing to commit secret-bearing files:"
  echo "$blocked" | sed 's/^/  - /'
  echo ""
  echo "These files must stay local. Use .env.example for safe templates only."
  exit 1
fi

exit 0
